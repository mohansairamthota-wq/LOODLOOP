# Copy this file to .env and edit.
# Leave MONGO_URI empty to run with a temporary in-memory database (demo data is loaded automatically, resets on restart).
# For real use, point it at your MongoDB, e.g. mongodb://127.0.0.1:27017/loadloop or a MongoDB Atlas URI.
MONGO_URI=
JWT_SECRET=change-this-to-a-long-random-string
PORT=5000
